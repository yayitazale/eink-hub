# Port the web UI and the frame pull endpoint listen on.
PORT=8080
# LAN address of this machine (not localhost): frames use it to reach the hub, and
# "Search the network" scans its subnet for BLOOMIN8 frames.
LOCAL_URL=http://192.168.1.10:8080
# Optional: address people use to open the hub (reverse proxy, Tailscale…).
# The QR code on the Canvas welcome picture opens this one; empty = LOCAL_URL.
# With Tailscale inside the container (Unraid's "Use Tailscale") it is detected automatically.
EXTERNAL_URL=
# Optional: public https address SwitchBot's cloud downloads photos from, when only
# /u/img is exposed (e.g. Tailscale Funnel on :8443). Empty = EXTERNAL_URL.
CLOUD_URL=
# Admin password. Leave empty to choose one on first visit.
ADMIN_PASSWORD=
# Set to true only on a trusted network / behind your own auth proxy.
AUTH_DISABLED=false
# Optional: can also be configured from Settings in the UI.
IMMICH_URL=http://192.168.1.20:2283
IMMICH_API_KEY=
TZ=Europe/Madrid
# Bluetooth wake through the host's BlueZ (needs /run/dbus mounted, see docs-site/guide/bluetooth.md).
# Set to true to turn it off entirely.
BLE_DISABLED=false
