# Port the web UI and the frame pull endpoint listen on.
PORT=8080
# LAN address the Canvases use to reach this hub in pull mode (machine IP, not localhost).
LOCAL_URL=http://192.168.1.10:8080
# Optional: address people use to open the hub (reverse proxy, Tailscale…).
# The QR code on the Canvas welcome picture opens this one; empty = LOCAL_URL.
EXTERNAL_URL=
# Admin password. Leave empty to choose one on first visit.
ADMIN_PASSWORD=
# Set to true only on a trusted network / behind your own auth proxy.
AUTH_DISABLED=false
# Optional: can also be configured from Settings in the UI.
IMMICH_URL=http://192.168.1.20:2283
IMMICH_API_KEY=
TZ=Europe/Madrid
