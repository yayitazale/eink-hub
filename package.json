{
  "name": "eink-hub",
  "private": true,
  "version": "0.3.5",
  "license": "MIT",
  "workspaces": ["apps/server", "apps/web"],
  "scripts": {
    "dev:server": "npm run dev -w apps/server",
    "dev:web": "npm run dev -w apps/web",
    "build": "npm run build -w apps/web && npm run build -w apps/server",
    "start": "npm start -w apps/server",
    "test": "npm test -w apps/server",
    "fake-frame": "npm run fake-frame -w apps/server"
  },
  "overrides": {
    "dbus-next": "npm:@jellybrick/dbus-next@^0.11.4"
  }
}
